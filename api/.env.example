# Copie este arquivo para .env antes de subir a API:
#   cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
# Os valores abaixo batem com o banco criado no passo 1 do README - se você
# não mudou nada no script, funciona direto.

# Conexão com o MySQL (usuário/senha/banco criados no passo 1).
DATABASE_URL="mysql://aerocode:aerocode@localhost:3306/aerocode"

# Banco auxiliar que o Prisma usa durante `npm run migrate` (prisma migrate dev).
SHADOW_DATABASE_URL="mysql://aerocode:aerocode@localhost:3306/aerocode_shadow"

# Segredo usado para assinar os tokens JWT - troque por um valor próprio.
JWT_SECRET="aerocode_dev_troque_em_producao"

# Porta da API e origem liberada no CORS (o front roda na 3000).
PORT=4000
CORS_ORIGIN="http://localhost:3000"
